{
  "name": "antfarm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A living 2D ant-colony sandbox — TypeScript simulation engine rendered with PixiJS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/eval/run.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "pixi.js": "^8.0.0"
  }
}
